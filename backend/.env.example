GOOGLE_SEARCH_PAGES=2
MAX_TOTAL_SEARCH_PAGES=15
MAX_SHOPPING_RESULTS=30
MAX_PRODUCT_PAGES=30
PRODUCT_LINKS_PER_LISTING=4
SEARCH_KEYWORD_LIMIT=6

OPENAI_API_KEY=your_openai_api_key_here
