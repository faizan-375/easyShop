NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
CLIENT_URLS=

SEARCH_PROVIDER=auto
MONGODB_URI=your_mongodb_uri_here
SERPAPI_API_KEY=your_serpapi_api_key_here
GOOGLE_CSE_API_KEY=your_google_cse_api_key_here
